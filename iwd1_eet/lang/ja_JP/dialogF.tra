@41218 = ~Easily done.~ [bdtpto05]
@41219 = ~If you insist.~ [bdtpto06]
@41220 = ~I hear you.~ [bdtpto07]
@41221 = ~[pain grunt]~ [bdtptol]
@41222 = ~[death grunt]~ [bdtptom]
@41223 = ~I sense many dangers in this place.~ [bdtptop]
@41224 = ~We live to see another dawn.~ [bdtptoq]
@41225 = ~The shadows hide many things. Watch yourself.~ [bdtptor]
@41226 = ~You are like a needy child.~ [bdtpto15]
@41227 = ~They'll find your body in the river.~ [bdtpto16]
@41228 = ~Yeeaahrrgh!~ [bdtptoz]
@41229 = ~Gods damn it!~ [bdtpto1]
@41230 = ~Useless!~ [bdtpto2]
@41231 = ~Huh, where would I put that?~ [bdtpto3]
@41232 = ~I have need of this.~ [bdtpto4]
@41233 = ~I will be as a shadow.~ [bdtpto5]
@41234 = ~Damn! My spell!~ [bdtpto6]
@41235 = ~I've lain a trap.~ [bdtpto7]
@41236 = ~I've traveled with many adventurers. And you are among the finest.~ [bdtpto10]
@41237 = ~We might want to watch our backs.~ [bdtpto11]
@41238 = ~If you continue on this path, it will soon diverge from mine.~ [bdtpto12]
@41239 = ~I have better things to do than waste my time here.~ [bdtpto13]
@41240 = ~There's no victory here! Retreat!~ [bdtpto14]
@41241 = ~We will honor your sacrifice.~ [bdtptow]
@41242 = ~Let's try diplomacy again!~ [bdtpam01]
@41243 = ~Oh no, it's far nobler to follow than lead. More profitable, too.~ [bdtpamb]
@41244 = ~*shiver* Yes, yes, very scenic. Let's go back to the inn now, hm?~ [bdtpamn]
@41245 = ~"Squalor." That's a good word. I need to remember that.~ [bdtpamo]
@41246 = ~I should get my portrait painted next to these mountains.~ [bdtpam08]
@41247 = ~You've read my "Rules for Avoiding a Horrible Death," haven't you?~ [bdtpam09]
@41248 = ~Cry havoc, and let slip the—ah, whatever!~ [bdtpbe01]
@41249 = ~You have excellent taste in leadership.~ [bdtpbeb]
@41250 = ~Snow. Ugh, truly the greatest horror of the surface world.~ [bdtpben]
@41251 = ~How do you rivvin live like this?~ [bdtpbeo]
@41252 = ~You can't spell "Baeloth" without "bae"! I regret that joke already.~ [bdtpbe08]
@41253 = ~There's no business like "snow" busine—ugh, god, no. No.~ [bdtpbe09]
@41254 = ~You are nothing!~ [bdtpag01]
@41255 = ~The power! THE POWER! Huhahahahahahahahahahaha!~ [bdtpagb]
@41256 = ~There's snow in my boots.~ [bdtpagn]
@41257 = ~What a desolate, miserable place. I like it.~ [bdtpago]
@41258 = ~If I get killed by wolves, please tell them what good dogs they are.~ [bdtpag08]
@41259 = ~I've got a lovely bunch of coconuts...~ [bdtpag09]
@41260 = ~My fist, your face!~ [bdtpdg01]
@41261 = ~Leader! Yay!~ [bdtpdgb]
@41262 = ~Saw a dire rabbit kill a whole band of knights, once.~ [bdtpdgn]
@41263 = ~Ugh, people. I hate people.~ [bdtpdgo]
@41264 = ~Come down here and fight me!~ [bdtpdg08]
@41265 = ~I'm charging by the click from here on out.~ [bdtpdg09]
@41266 = ~Here we go!~ [bdtpeh01]
@41267 = ~Ooh! I'll be a great leader!~ [bdtpehb]
@41268 = ~It's so pretty out here. Almost makes up for all the death.~ [bdtpehn]
@41269 = ~Oh, ew! I just stepped in something!~ [bdtpeho]
@41270 = ~I am down to clown.~ [bdtpeh08]
@41271 = ~I once read a book about how not to die here.~ [bdtpeh09]
@41272 = ~Let them meet our best!~ [bdtpsd01]
@41273 = ~I will prove myself worthy of your faith.~ [bdtpsdb]
@41274 = ~It's very... brisk.~ [bdtpsdn]
@41275 = ~Amazing, how life endures even out here.~ [bdtpsdo]
@41276 = ~Don't give into the cold—our hearts are ablaze!~ [bdtpsd08]
@41277 = ~I haven't a clue what you mean by that!~ [bdtpsd09]
@41278 = ~You will die here!~ [bdtpto01]
@41279 = ~I will break our trail.~ [bdtptob]
@41280 = ~Only the strong survive here.~ [bdtpton]
@41281 = ~An impressive settlement, all things considered.~ [bdtptoo]
@41282 = ~Are you not entertained?~ [bdtpto08]
@41283 = ~Go pester an ice giant.~ [bdtpto09]
@41284 = "~ Hungarian Translation ~

~ By András Oroszi and Peter Methall ~
"
@41285 = ~This is a Work In Progress. Want to help? Come join us at:

https://translate.beamdog.com/~
