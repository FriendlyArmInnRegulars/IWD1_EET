@40975 = ~[pain grunt]~ [bdtpaml]
@40976 = ~[death grunt]~ [bdtpamm]
@40977 = ~This place reminds me of my dear departed friend... er... what was his name...~ [bdtpamp]
@40978 = ~As Uncle Marthur used to say, "Any day you live through is a good one."~ [bdtpamq]
@40979 = ~Another day ended, and we haven't died horribly. I call that a success.~ [bdtpamr]
@40980 = ~You remind me of my cousin Kadina. She's also infuriating.~ [bdtpam15]
@40981 = ~Do you want something? An autograph, perhaps?~ [bdtpam16]
@40982 = ~Aha! Take that!~ [bdtpamz]
@40983 = ~Oh dear.~ [bdtpam1]
@40984 = ~Not working! Not working at all!~ [bdtpam2]
@40985 = ~Stop handing me things. Do I look like I'm made of hands?~ [bdtpam3]
@40986 = ~Possession is nine tenths of the law, you know.~ [bdtpam4]
@40987 = ~Ah, yes. Hiding. My second-favorite tactic.~ [bdtpam5]
