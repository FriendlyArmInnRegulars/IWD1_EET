@19183 = ~[ALDETH 10] 何か手伝うことはあるかね？~ [ALDET10]
@19184 = ~[ALDETH 11] そんな！ 狂ってる！~ [ALDET11]
@19185 = ~[ALDETH 12] 狂ってる！ 仲間内で戦う必要などないだろう！~ [ALDET12]
@19186 = ~[ALDETH 13] 鬼め！　まだ子供なのに！　助けてくれ！~ [ALDET13]
