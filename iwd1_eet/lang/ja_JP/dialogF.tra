@40959 = ~*yawn* Some of us need our beauty sleep, you know.~ [bdtpamc]
@40960 = ~I adore tedium. It's vastly preferable to screaming and running for our lives.~ [bdtpamd]
@40961 = ~Argh! I want to live!~ [bdtpame]
@40962 = ~Yes?~ [bdtpamf]
@40963 = ~At your service.~ [bdtpamg]
